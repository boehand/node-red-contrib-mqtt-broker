{"version": 2, "width": 96, "height": 28, "timestamp": 1776890885, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "linux"}}
[0.006535, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.007353, "o", "\u001b[0;33m# node-red-contrib-mosquitto-broker - demo\u001b[0m\r\n"]
[1.60991, "o", "\u001b[0;33m# 1) mosquitto already installed by the module postinstall\u001b[0m\r\n"]
[2.211741, "o", "\u001b[1;36m$ \u001b[0;37mmosquitto -h | head -n 1\u001b[0m\r\n"]
[2.214862, "o", "mosquitto version 2.0.18\r\n"]
[3.016697, "o", "\u001b[0;33m# 2) Boot the broker the way Node-RED does (minimal RED harness)\u001b[0m\r\n"]
[3.618224, "o", "\u001b[1;36m$ \u001b[0;37mnode demo/run-broker.js &\u001b[0m\r\n"]
[3.665318, "o", "[node status] yellow  starting\r\n"]
[4.169406, "o", "[node status] green  running :18840\r\n"]
[5.620049, "o", "\u001b[0;33m# 3) Subscribe to test/demo in the background\u001b[0m\r\n"]
[6.221865, "o", "\u001b[1;36m$ \u001b[0;37mmosquitto_sub -h 127.0.0.1 -p 18840 -t test/demo -v &\u001b[0m\r\n"]
[7.223752, "o", "\u001b[0;33m# 4) Publish a message through the brokered node\u001b[0m\r\n"]
[7.825338, "o", "\u001b[1;36m$ \u001b[0;37mmosquitto_pub -h 127.0.0.1 -p 18840 -t test/demo -m 'hello from Node-RED'\u001b[0m\r\n"]
[7.8279, "o", "test/demo hello from Node-RED\r\n"]
[9.02976, "o", "\u001b[0;33m# 5) Confirm the broker is actually listening on :18840\u001b[0m\r\n"]
[9.63136, "o", "\u001b[1;36m$ \u001b[0;37mss -ltn | awk 'NR==1 || /:18840 /'\u001b[0m\r\n"]
[9.634441, "o", "State  Recv-Q Send-Q Local Address:Port  Peer Address:PortProcess\r\nLISTEN 0      100        127.0.0.1:18840      0.0.0.0:*          \r\n"]
[10.436665, "o", "\u001b[0;33m# 6) Clean shutdown (same path as Node-RED redeploy)\u001b[0m\r\n"]
[11.038375, "o", "\u001b[1;36m$ \u001b[0;37mkill -TERM 3665   # SIGTERM -> node calls stop() -> mosquitto exits\u001b[0m\r\n"]
[11.038683, "o", "[demo] shutting down broker...\r\n"]
[11.141471, "o", "[node status] grey  stopped\r\n"]
[11.142414, "o", "[demo] broker stopped.\r\n"]
[11.948996, "o", "\u001b[0;33m# Done.\u001b[0m\r\n"]
