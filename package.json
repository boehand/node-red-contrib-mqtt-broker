{
  "name": "node-red-contrib-mosquitto-broker",
  "version": "0.1.0",
  "description": "Node-RED node that runs a Mosquitto MQTT broker as a child process, managed by the Node-RED runtime.",
  "keywords": [
    "node-red",
    "mqtt",
    "mosquitto",
    "broker"
  ],
  "license": "Apache-2.0",
  "main": "none",
  "scripts": {
    "test": "node test/integration.test.js",
    "postinstall": "node scripts/install-mosquitto.js",
    "install-mosquitto": "node scripts/install-mosquitto.js"
  },
  "files": [
    "nodes/",
    "scripts/",
    "examples/",
    "test/"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "mosquitto-broker": "nodes/mosquitto-broker.js"
    }
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/boehand/test.git"
  }
}
