{
  "name": "node-red-contrib-mqtt-broker",
  "version": "0.4.0",
  "description": "Node-RED node that runs an MQTT broker (Mosquitto) as a child process, managed by the Node-RED runtime.",
  "keywords": [
    "node-red",
    "mqtt",
    "mosquitto",
    "broker"
  ],
  "license": "Apache-2.0",
  "main": "none",
  "scripts": {
    "test": "node test/integration.test.js",
    "postinstall": "node scripts/install-mosquitto.js",
    "install-mosquitto": "node scripts/install-mosquitto.js",
    "demo:record": "asciinema rec --overwrite --cols 96 --rows 28 --idle-time-limit 2 -c 'bash demo/demo.sh' demo/demo.cast",
    "demo:render": "agg --cols 96 --rows 28 --font-size 16 --speed 1.2 --theme monokai demo/demo.cast docs/demo.gif",
    "demo": "npm run demo:record && npm run demo:render"
  },
  "files": [
    "nodes/",
    "lib/",
    "scripts/",
    "examples/",
    "test/",
    "docs/",
    "README.md"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "mqtt-broker": "nodes/mqtt-broker.js"
    }
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "mqtt": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boehand/test.git"
  }
}
